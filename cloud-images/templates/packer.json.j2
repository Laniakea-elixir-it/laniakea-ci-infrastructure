{
	"builders": [
		{
			"type": "openstack",
			"ssh_username": "{{ ssh_username }}",
			"image_name": "{{ name }}_{{ version }}",
			"source_image": "{{ source_image }}",
			"flavor": "{{ flavor }}",
			"ssh_ip_version": "4",
			"networks": [
				"{{ network_id }}"
			]
		}
	],
	"provisioners": [
		{
			"type": "ansible",
                        {% if 'galaxy' in playbook_file %}
                        "extra_arguments": ["--extra-vars","@./ansible-playbooks/galaxy/group_vars/galaxy.yml"],
                        {% elif 'rockylinux-laniakea-dev' in playbook_file %}
                        "extra_arguments": ["--extra-vars","@./inventory/group_vars/rockylinux-laniakea-dev.yml"],
                        {% elif 'vgcn' in playbook_file %}
                        "extra_arguments": ["--extra-vars","@./inventory/group_vars/vgcn.yml"],
                        {% endif%}
			"inventory_directory": "./inventory/",
                        {% if ansible_galaxy_file %}
                        "galaxy_file": "./{{ ansible_galaxy_file }}",
                        {% endif %}
			"playbook_file": "./{{ playbook_file }}",
			"galaxy_force_install": true
                        
		}{% if 'galaxy' in playbook_file %},
		{
			"type": "ansible",
			"extra_arguments": ["--extra-vars","@./ansible-playbooks/galaxy/group_vars/galaxy.yml"],
			"inventory_directory": "./inventory/",
			"playbook_file": "./ansible-playbooks/stop_galaxy_services.yml"
		}{% endif %}
	]
}
